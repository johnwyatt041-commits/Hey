<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@color/background_dark">

    <!-- Global Speaker Destination Switch (Top Center) -->
    <LinearLayout
        android:id="@+id/speakerDestToggle"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/speaker_dest_pill_height"
        android:layout_marginTop="@dimen/speaker_dest_margin_top"
        android:background="@drawable/bg_speaker_toggle_container"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tabDestExternal"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/bg_speaker_toggle_active"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/speaker_dest_external_short"
            android:textColor="@color/on_primary"
            android:textSize="@dimen/speaker_dest_pill_text_size"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tabDestCabin"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/speaker_dest_cabin_short"
            android:textColor="@color/on_surface_dim"
            android:textSize="@dimen/speaker_dest_pill_text_size"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Audio-reactive ripple (concentric rings, centered on button) -->
    <com.kooo.hey.ui.AudioGlowView
        android:id="@+id/audioGlow"
        android:layout_width="@dimen/audio_glow_size"
        android:layout_height="@dimen/audio_glow_size"
        app:layout_constraintBottom_toBottomOf="@id/countdownRing"
        app:layout_constraintEnd_toEndOf="@id/countdownRing"
        app:layout_constraintStart_toStartOf="@id/countdownRing"
        app:layout_constraintTop_toTopOf="@id/countdownRing" />

    <!-- Countdown ring (behind button, same center) -->
    <com.kooo.hey.ui.CountdownRingView
        android:id="@+id/countdownRing"
        android:layout_width="@dimen/countdown_ring_size"
        android:layout_height="@dimen/countdown_ring_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.45" />

    <!-- Main talk button (centered inside the ring) -->
    <FrameLayout
        android:id="@+id/talkButton"
        android:layout_width="@dimen/talk_button_size"
        android:layout_height="@dimen/talk_button_size"
        android:background="@drawable/bg_talk_idle"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="@id/countdownRing"
        app:layout_constraintEnd_toEndOf="@id/countdownRing"
        app:layout_constraintStart_toStartOf="@id/countdownRing"
        app:layout_constraintTop_toTopOf="@id/countdownRing">

        <ImageView
            android:id="@+id/micIcon"
            android:layout_width="@dimen/mic_icon_size"
            android:layout_height="@dimen/mic_icon_size"
            android:layout_gravity="center"
            android:src="@drawable/ic_mic"
            android:tint="@color/mic_icon_idle"
            android:contentDescription="Microphone" />

    </FrameLayout>

    <!-- Status text -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/status_text_margin_top"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.05"
        android:text="@string/status_idle"
        android:textColor="@color/on_surface_dim"
        android:textSize="@dimen/status_text_size"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/countdownRing" />

    <!-- Error hint -->
    <TextView
        android:id="@+id/errorText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/error_text_margin_top"
        android:fontFamily="sans-serif"
        android:textColor="@color/red_primary"
        android:textSize="@dimen/error_text_size"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusText" />

    <!-- Function buttons row: Quick Buttons + Add Button + Music -->
    <HorizontalScrollView
        android:id="@+id/functionButtonsScrollView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/func_row_margin_top"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/errorText">

        <LinearLayout
            android:id="@+id/functionButtonsRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Container for dynamically added quick sound buttons -->
            <LinearLayout
                android:id="@+id/quickButtonsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal" />

            <!-- Add Quick Sound Button (+) -->
            <LinearLayout
                android:id="@+id/btnAddQuickButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_marginEnd="@dimen/func_button_spacing">

                <ImageView
                    android:id="@+id/btnAddQuickButtonIcon"
                    android:layout_width="@dimen/func_button_size"
                    android:layout_height="@dimen/func_button_size"
                    android:background="@drawable/bg_func_button_ripple"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="@dimen/func_button_padding"
                    android:src="@drawable/ic_add"
                    android:tint="@color/ve_icon_tint"
                    android:contentDescription="@string/quick_sound_add_button" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/func_label_margin_top"
                    android:text="@string/quick_sound_add_button"
                    android:textColor="@color/on_surface_dim"
                    android:textSize="@dimen/func_label_text_size" />
            </LinearLayout>

            <!-- Music player toggle button -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/musicButton"
                    android:layout_width="@dimen/func_button_size"
                    android:layout_height="@dimen/func_button_size"
                    android:background="@drawable/bg_func_button_ripple"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="@dimen/func_button_padding"
                    android:src="@drawable/ic_music"
                    android:tint="@color/ve_icon_tint"
                    android:contentDescription="@string/music_title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/func_label_margin_top"
                    android:text="@string/music_title"
                    android:textColor="@color/on_surface_muted"
                    android:textSize="@dimen/func_label_text_size" />
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Music player panel (replaces center circle when active) -->
    <include
        android:id="@+id/musicPanel"
        layout="@layout/panel_music_player"
        android:layout_width="@dimen/panel_width"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/panel_margin_bottom"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/audioGlow" />

    <!-- Barrier at left edge of whichever panel is visible -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/panelStartBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="musicPanel" />

    <!-- Back button (left of panels, vertically centered, shown when panel is open) -->
    <LinearLayout
        android:id="@+id/panelBackButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_marginEnd="@dimen/back_button_margin_end"
        android:visibility="gone"
        android:layout_marginBottom="@dimen/panel_margin_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/panelStartBarrier"
        app:layout_constraintTop_toTopOf="@id/audioGlow">

        <ImageView
            android:layout_width="@dimen/func_button_size"
            android:layout_height="@dimen/func_button_size"
            android:background="@drawable/bg_func_button_ripple"
            android:padding="@dimen/back_button_padding"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/ve_icon_tint"
            android:contentDescription="返回" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/func_label_margin_top"
            android:text="返回"
            android:textColor="@color/on_surface_muted"
            android:textSize="@dimen/func_label_text_size" />
    </LinearLayout>

    <!-- Gain slider (left side, vertical: Talk Mic Gain) -->
    <com.kooo.hey.ui.GainSliderView
        android:id="@+id/gainSlider"
        android:layout_width="@dimen/gain_slider_width"
        android:layout_height="@dimen/gain_slider_height"
        android:layout_marginStart="@dimen/gain_slider_margin_start"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.45" />

    <!-- Music Volume slider (right side, vertical: Music / Quick Sound Volume) -->
    <com.kooo.hey.ui.GainSliderView
        android:id="@+id/musicVolumeSlider"
        android:layout_width="@dimen/gain_slider_width"
        android:layout_height="@dimen/gain_slider_height"
        android:layout_marginEnd="@dimen/gain_slider_margin_start"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.45" />

    <!-- Settings gear button (bottom left, single tap to open) -->
    <ImageView
        android:id="@+id/settingsButton"
        android:layout_width="@dimen/corner_button_size"
        android:layout_height="@dimen/corner_button_size"
        android:layout_marginStart="@dimen/corner_button_margin"
        android:layout_marginBottom="@dimen/corner_button_margin"
        android:alpha="0.35"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackgroundBorderless"
        android:padding="@dimen/corner_button_padding"
        android:src="@drawable/ic_settings"
        android:tint="@color/on_surface"
        android:contentDescription="Settings"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Guide info button (bottom right) -->
    <TextView
        android:id="@+id/guideButton"
        android:layout_width="@dimen/corner_button_size"
        android:layout_height="@dimen/corner_button_size"
        android:layout_marginEnd="@dimen/corner_button_margin"
        android:layout_marginBottom="@dimen/corner_button_margin"
        android:alpha="0.35"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:text="!"
        android:textColor="@color/on_surface"
        android:textSize="@dimen/guide_text_size"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:contentDescription="使用指南"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
