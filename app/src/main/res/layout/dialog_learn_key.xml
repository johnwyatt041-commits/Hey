<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/dialogLearnTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="@string/quick_sound_learn_title"
        android:textColor="@color/on_surface"
        android:textSize="@dimen/dialog_title_size" />

    <TextView
        android:id="@+id/textLearnHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/quick_sound_learn_hint"
        android:textColor="@color/on_surface_dim"
        android:textSize="@dimen/dialog_body_size" />

    <!-- Detected Key Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_dialog_input"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/textDetectedKey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quick_sound_learn_hint"
            android:textColor="@color/on_surface_muted"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Gesture Selection -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/quick_sound_gesture_label"
        android:textColor="@color/on_surface_dim"
        android:textSize="@dimen/dialog_body_size" />

    <RadioGroup
        android:id="@+id/radioGroupGesture"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbGestureSingle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/quick_sound_gesture_single"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/dialog_body_size" />

        <RadioButton
            android:id="@+id/rbGestureDouble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/quick_sound_gesture_double"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/dialog_body_size" />

        <RadioButton
            android:id="@+id/rbGestureLong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/quick_sound_gesture_long"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/dialog_body_size" />
    </RadioGroup>

    <!-- Dialog buttons row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancelLearn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dialog_button"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:text="@string/permission_dialog_cancel"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/dialog_button_size" />

        <TextView
            android:id="@+id/btnConfirmLearn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_dialog_button_primary"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="@string/quick_sound_confirm"
            android:textColor="@color/on_primary"
            android:textSize="@dimen/dialog_button_size" />
    </LinearLayout>
</LinearLayout>
