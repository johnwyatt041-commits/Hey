<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/guideRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E81A2030"
    android:clickable="true"
    android:focusable="true">

    <!-- Postcard-style note card, no heavy background, just text -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:paddingStart="64dp"
        android:paddingEnd="64dp"
        android:paddingTop="40dp"
        android:paddingBottom="48dp">

        <!-- Title: Hey！ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hey！"
            android:textColor="#FFFFFFFF"
            android:textSize="93sp"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <!-- Spacer -->
        <View
            android:layout_width="48dp"
            android:layout_height="2dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp"
            android:background="#50FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="准备好体验一下，超好玩的大喇叭了吗！"
            android:textColor="#F0FFFFFF"
            android:textSize="48sp"
            android:fontFamily="serif"
            android:lineSpacingExtra="12dp" />

        <View
            android:layout_width="1dp"
            android:layout_height="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hey！的使用很简单，\n短按可进行1分钟的喊话，长按可持续喊话。"
            android:textColor="#E0FFFFFF"
            android:textSize="40sp"
            android:fontFamily="serif"
            android:lineSpacingExtra="11dp" />

        <View
            android:layout_width="1dp"
            android:layout_height="22dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="我为大家提供了快捷喊话功能，\n长按右手边OK键，或点按悬浮窗即可喊话。"
            android:textColor="#E0FFFFFF"
            android:textSize="40sp"
            android:fontFamily="serif"
            android:lineSpacingExtra="11dp" />

        <View
            android:layout_width="1dp"
            android:layout_height="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="左下角有个调试面板，可以做一些自定义配置哦！"
            android:textColor="#E0FFFFFF"
            android:textSize="40sp"
            android:fontFamily="serif"
            android:lineSpacingExtra="11dp" />

        <View
            android:layout_width="1dp"
            android:layout_height="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="如果声音不够大，记得去系统设置里拉高外扬声器音量！"
            android:textColor="#E0FFFFFF"
            android:textSize="40sp"
            android:fontFamily="serif"
            android:lineSpacingExtra="11dp" />

        <View
            android:layout_width="1dp"
            android:layout_height="18dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="注意！喊话时记得关窗，只输出，不接收！"
            android:textColor="#FFFFD600"
            android:textSize="40sp"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:lineSpacingExtra="11dp" />

        <View
            android:layout_width="1dp"
            android:layout_height="32dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="使用提示：\n本软件本质为“扩音器”软件，通过麦克风收音、扬声器发音。\n请勿在危险场景下使用或用于违法用途，也请勿用本软件辱骂他人。\n请友好、文明地使用本软件与他人交流。"
            android:textColor="#BFFFFFFF"
            android:textSize="26sp"
            android:fontFamily="serif"
            android:lineSpacingExtra="11dp" />

        <!-- Dismiss hint -->
        <TextView
            android:id="@+id/guideDismissHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="点击任意位置关闭"
            android:textColor="#80FFFFFF"
            android:textSize="24sp"
            android:fontFamily="sans-serif" />

    </LinearLayout>

</FrameLayout>
